# Copy to .env and edit. Nothing here is required except what you want to enable.

# --- LLM (CV extraction + email personalisation). Without a key the app uses basic extraction
# --- and a fixed email template. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Security keys. Leave blank: they are generated on first run and stored in data/ (mode 600).
# --- Set FERNET_KEY yourself if you keep data/ somewhere else or run several containers.
# --- Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_SECRET_KEY=
FERNET_KEY=

# --- Hosts. Single-user app with NO login: keep this local. Anything else shows a warning banner.
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database: SQLite by default. For PostgreSQL: postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Redis (Celery broker). docker compose overrides this to point at the redis container.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Timezone used for "today" when counting the daily send limit.
TIME_ZONE=UTC

# --- LinkedIn public job pages (remote jobs, no login). LinkedIn's terms prohibit automated access and it
# --- throttles; set to false to disable.
LINKEDIN_ENABLED=true
LINKEDIN_REQUEST_DELAY=2.5

# --- LinkedIn hiring posts with an HR email, found through an OFFICIAL search API (the app never fetches
# --- linkedin.com for this). Pick one provider and add its key. Without a key this source stays off.
# --- Brave Search API: https://brave.com/search/api/  (recommended)
# --- Google Programmable Search JSON API is closed to new customers and ends 2027-01-01.
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
SEARCH_MAX_QUERIES=6
# Never email the same address more than once in this many days (all jobs)
CONTACT_CAP_DAYS=30

# --- Optional job sources (leave blank to disable)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
JSEARCH_API_KEY=

# --- Sending: random pause between emails, in seconds
SEND_DELAY_MIN=20
SEND_DELAY_MAX=60

# --- Jobs scoring below this (0-100) are hidden as irrelevant
MIN_MATCH_SCORE_TO_KEEP=20
